const SHEET_NAME='Responses';const HEADERS=['Timestamp','university','province','age_group','gender','degree_level','monthly_spending','apps','usage_frequency','purposes','ease_of_use','security','trust','time_saving','affordability','recommendation','problems','prefer_apps','future_use','improvement','comments'];function doPost(e){try{const ss=SpreadsheetApp.getActiveSpreadsheet(),sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);if(!sh.getLastRow())sh.getRange(1,1,1,HEADERS.length).setValues([HEADERS]);const d=JSON.parse(e.postData.contents||'{}');sh.appendRow(HEADERS.map((h,i)=>i?d[h]??'':new Date()));return out({ok:true})}catch(x){return out({ok:false,error:String(x)})}}function doGet(){return ContentService.createTextOutput('Survey endpoint is ready.')}function out(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}